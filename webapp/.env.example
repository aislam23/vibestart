# Self-hosted Supabase (GoTrue via Kong), reachable directly from the browser.
VITE_SUPABASE_URL=http://localhost:54321
# From infra/supabase/.env (ANON_KEY). Safe to expose to the browser - it is the public,
# row-level-security-scoped key, not the service role key.
VITE_SUPABASE_ANON_KEY=REPLACE_WITH_ANON_KEY

# vibestart backend (Bun/Hono), verifies the Supabase-issued JWT on every request.
VITE_API_URL=http://localhost:3000
