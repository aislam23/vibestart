# Local Supabase Postgres (infra/supabase/docker-compose.yml maps it to
# 127.0.0.1:54322). Copy POSTGRES_PASSWORD from infra/supabase/.env after
# running `bun run secrets:generate` from the repo root.
#
# This is the connection the running app uses at request time. Before the
# "Runtime DB role" is activated (see backend/README.md), it is fine for this
# to be the same superuser connection `prisma migrate` uses. Once activated,
# point this at the least-privileged `backend_runtime` role instead and set
# MIGRATE_DATABASE_URL below to the superuser connection for migrations.
DATABASE_URL="postgresql://postgres:PASSWORD@localhost:54322/postgres"
# Optional. Superuser connection `prisma migrate`/`prisma migrate deploy` use
# for schema changes. Falls back to DATABASE_URL when unset - the common case
# before the backend_runtime role is ever activated. See backend/README.md,
# "Runtime DB role".
#
# Must connect as `supabase_admin`, not `postgres`: in this self-hosted
# Supabase Postgres image, `postgres` is NOT an actual superuser and lacks
# GRANT OPTION on the `auth` schema, so the backend_runtime_role migration's
# `auth`-schema statements silently no-op under it (a Postgres WARNING, not an
# error - `prisma migrate deploy` reports success either way).
# MIGRATE_DATABASE_URL="postgresql://supabase_admin:PASSWORD@localhost:54322/postgres"

# Self-hosted Supabase Auth (GoTrue), reachable through Kong.
SUPABASE_URL="http://localhost:54321"
# GoTrue, PostgREST, Realtime, and Storage all sign/verify with this same
# secret - copy JWT_SECRET from infra/supabase/.env, not ANON_KEY or
# SERVICE_ROLE_KEY (those are JWTs *signed with* this secret, not the secret
# itself).
SUPABASE_JWT_SECRET="REPLACE_WITH_SUPABASE_JWT_SECRET"
# Optional. The `iss` claim GoTrue stamps on tokens it issues; defaults to
# "${SUPABASE_URL}/auth/v1". Override only if GoTrue's external auth URL
# differs from SUPABASE_URL. In production this MUST equal GoTrue's external
# auth URL, e.g. "https://supabase.example.com/auth/v1" - not an internal or
# Docker-network hostname.
# SUPABASE_JWT_ISSUER="http://localhost:54321/auth/v1"
# Optional: only needed once a module calls Supabase's admin API directly.
# Copy SERVICE_ROLE_KEY from infra/supabase/.env if so. Never expose it to a
# browser client.
SERVICE_ROLE_KEY=""

PORT="3000"
CORS_ORIGINS="http://localhost:5173,http://localhost:8081,http://localhost:19006"
SHUTDOWN_GRACE_SECONDS="20"

# Independent rate-limit budget for GET /api/admin/users, keyed by administrator id.
ADMIN_USERS_READ_RATE_LIMIT_MAX="120"
ADMIN_USERS_READ_RATE_LIMIT_WINDOW_SECONDS="60"

TRUST_PROXY="false"
# Required when TRUST_PROXY=true. Use do-connecting-ip on DigitalOcean App
# Platform; for a comma-separated proxy chain, set first or last to match the
# provider's contract.
# TRUSTED_PROXY_CLIENT_IP_HEADER="do-connecting-ip"
# TRUSTED_PROXY_CLIENT_IP_POSITION="first"
