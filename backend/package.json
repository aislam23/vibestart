{
  "name": "@vibestart/backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun run prisma:generate && bun --watch src/index.ts",
    "start": "bun run prisma:generate && bun src/index.ts",
    "start:cron": "bun src/cron.ts",
    "start:scheduler": "bun src/scheduler.ts",
    "start:worker": "bun src/worker.ts",
    "build": "bun run prisma:generate && tsc --noEmit",
    "typecheck": "bun run prisma:generate && tsc --noEmit",
    "test": "bun test src",
    "test:integration": "bun scripts/test-integration.mjs",
    "smoke:docker": "bun scripts/docker-smoke.mjs",
    "prisma": "prisma",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:validate": "prisma validate"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.4.0",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@vibestart/contracts": "workspace:*",
    "croner": "^10.0.1",
    "dotenv": "^17.4.2",
    "hono": "^4.12.31",
    "jose": "^6.2.3",
    "pg": "^8.20.0",
    "prisma": "^7.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/pg": "^8.20.0",
    "typescript": "~6.0.3"
  }
}
