---
import { Database, LayoutTemplate, MonitorSmartphone, ShieldCheck } from 'lucide-react'

const scenarios = [
  {
    icon: LayoutTemplate,
    title: 'Sites and landing pages',
    description: 'Build a product site, a catalog, or a promo page from ready-made, responsive sections.',
  },
  {
    icon: MonitorSmartphone,
    title: 'Web apps',
    description: 'Add a user dashboard, an admin panel, forms, and user actions.',
  },
  {
    icon: ShieldCheck,
    title: 'Accounts and auth',
    description: 'Sign-up, login, and role-based access are already wired up between the backend and the web app.',
  },
  {
    icon: Database,
    title: 'Data and integrations',
    description: 'Add a database schema, background jobs, and external services as the product needs them.',
  },
]
---

<section class="border-b bg-black py-20 text-white sm:py-24" id="scenarios" aria-labelledby="scenarios-title">
  <div class="site-container">
    <div class="grid items-end gap-6 lg:grid-cols-[1fr_0.7fr]">
      <div>
        <p class="text-sm font-bold tracking-[0.16em] text-white/55 uppercase">What you can build</p>
        <h2 class="glow-text mt-3 max-w-3xl font-heading text-3xl font-bold tracking-tight text-balance sm:text-4xl" id="scenarios-title">
          Build one part, or the whole product
        </h2>
      </div>
      <p class="text-base leading-7 text-white/60 text-pretty sm:text-lg lg:justify-self-end">
        Start with what you need right now. The rest connects into the same project whenever you're ready for it.
      </p>
    </div>

    <div class="mt-12 grid gap-px overflow-hidden rounded-2xl bg-white/10 ring-1 ring-white/10 sm:grid-cols-2">
      {scenarios.map(({ icon: Icon, title, description }, index) => (
        <article class="group relative min-h-64 bg-black p-7 transition-colors hover:bg-white/5 sm:p-8">
          <div class="flex items-start justify-between gap-4">
            <span class="grid size-11 place-items-center rounded-xl bg-white/10 text-white transition-colors group-hover:bg-white group-hover:text-black">
              <Icon className="size-5" aria-hidden="true" />
            </span>
            <span class="font-heading text-sm font-bold text-white/55 tabular-nums">0{index + 1}</span>
          </div>
          <h3 class="mt-12 max-w-sm font-heading text-xl font-bold">{title}</h3>
          <p class="mt-3 max-w-md leading-6 text-white/60">{description}</p>
        </article>
      ))}
    </div>
  </div>
</section>
