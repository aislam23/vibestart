---
import { Card, CardContent } from '@/components/ui/card'
import { Separator } from '@/components/ui/separator'
import SectionIntro from './SectionIntro.astro'

const metrics = [
  ['Keep going', 'give the agent new tasks in the same project'],
  ['Hand off', 'the source code to a developer with nothing to migrate'],
  ['Deploy', 'put the site and backend on your own hosting'],
]
---

<section class="border-b py-20 sm:py-24" id="results" aria-labelledby="results-title">
  <div class="site-container">
    <div>
      <SectionIntro
        align="center"
        eyebrow="What you keep"
        title="Source code you can keep building on"
        titleId="results-title"
        description="You can run the project locally, deploy it to your own hosting, and hand it off to a developer. You're not locked into a closed builder."
      />
    </div>

    <div class="mt-12 grid gap-5 lg:grid-cols-[1.15fr_0.85fr]">
      <Card className="glow-surface justify-between bg-[#0d0d0d] text-white ring-white/12">
        <CardContent className="flex h-full flex-col justify-between gap-10 p-7 sm:p-9">
          <p class="text-sm font-bold tracking-[0.16em] text-white/55 uppercase">No closed builder</p>
          <p class="glow-text font-heading text-2xl leading-snug font-bold text-balance sm:text-3xl">
            The project is made of ordinary source files. Keep them in your own repository, open them in your
            editor, and hand them to a developer.
          </p>
        </CardContent>
      </Card>

      <Card>
        <CardContent className="flex h-full flex-col justify-center p-7 sm:p-9">
          {metrics.map(([value, label], index) => (
            <div>
              {index > 0 && <Separator className="my-6" />}
              <p class="glow-text font-heading text-4xl font-bold tracking-tight">{value}</p>
              <p class="mt-2 text-sm leading-6 text-muted-foreground">{label}</p>
            </div>
          ))}
        </CardContent>
      </Card>
    </div>
  </div>
</section>
