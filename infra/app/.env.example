# Config for the production app stack (infra/app/docker-compose.yml).
#
# cp .env.example .env, fill in real values, keep .env out of git (already
# covered by the root .gitignore's `infra/**/.env`). Every variable below
# maps 1:1 to backend/src/env.ts (see backend/README.md's "Env" table for
# the authoritative description of each) except BACKEND_IMAGE and
# MIGRATE_DATABASE_URL, which are compose/Prisma-level, not part of the
# Zod-validated app env.

############
# Image
############

# GHCR reference built and pushed by .github/workflows/deploy.yml, e.g.
# ghcr.io/<owner>/<repo>-backend:latest or a specific tag/sha for a pinned
# rollback (see infra/app/README.md, "Rollback").
BACKEND_IMAGE=ghcr.io/REPLACE_WITH_OWNER/REPLACE_WITH_REPO-backend:latest

############
# Database
############

# The RUNNING application's connection, as the least-privileged
# `backend_runtime` role (CRUD, no DDL - see backend/README.md, "Runtime DB
# role"). `db` resolves by Docker service name on the `supabase` network
# (infra/supabase/docker-compose.yml) - NOT localhost, and NOT port 5432:
# infra/supabase deliberately runs Postgres on port 54322 both on the host
# AND inside the container (POSTGRES_PORT in infra/supabase/.env, confirmed
# via that stack's own healthcheck, which relies on PGPORT rather than
# passing -p) - unlike backend/docker-compose.test.yml's throwaway db_test,
# which pins PGPORT back to the standard 5432.
#
# `backend_runtime` is created NOLOGIN by the `backend_runtime_role`
# migration - it must be activated by hand, once, as a superuser, BEFORE
# `backend` can actually connect with this URL:
#   ALTER ROLE backend_runtime LOGIN PASSWORD '<generated>';
# Generate <generated> yourself (e.g. `openssl rand -base64 32`); it does
# NOT need to match POSTGRES_PASSWORD. See docs/DEPLOYMENT.md, "First-run
# order", and backend/README.md, "Runtime DB role", for the full sequence -
# this MUST run after `make app-migrate` (which creates the role) and
# before `make app-up` (which connects as it).
DATABASE_URL=postgresql://backend_runtime:REPLACE_WITH_BACKEND_RUNTIME_PASSWORD@db:54322/postgres
# Superuser connection the one-shot `migrate` service (`make app-migrate`,
# `prisma migrate deploy`) uses for schema changes - separate from the
# `backend` service above by design, so the long-running app process never
# holds superuser credentials (see docker-compose.yml's `migrate` service
# comment). Must connect as `supabase_admin`, not `postgres` - see
# backend/README.md, "Runtime DB role", for why `postgres` silently no-ops
# the auth-schema GRANTs this migration needs. Uses the same
# POSTGRES_PASSWORD as infra/supabase/.env (supabase_admin shares it with
# every other login role there - see that file's "Rotating secrets").
MIGRATE_DATABASE_URL=postgresql://supabase_admin:REPLACE_WITH_POSTGRES_PASSWORD@db:54322/postgres

############
# Supabase
############

# Internal Kong URL - reachable by Docker service name on the `supabase`
# network. NOT the public https://<SUPABASE_DOMAIN>: that URL only exists
# once infra/edge's Caddy is proxying to kong, and going out to the internet
# and back in for every backend request would be wasteful and one more thing
# that can fail. This is only used for calls the backend itself makes to
# Supabase (e.g. the admin API via SERVICE_ROLE_KEY, if a module ever adds
# one) - it is NOT the `iss` claim tokens are checked against, see
# SUPABASE_JWT_ISSUER below for that.
SUPABASE_URL=http://kong:8000
# The `iss` claim GoTrue stamps on every token it issues - this MUST be the
# PUBLIC GoTrue URL (https://<SUPABASE_DOMAIN>/auth/v1, matching
# infra/edge/.env's SUPABASE_DOMAIN and infra/supabase/.env's
# API_EXTERNAL_URL), never the internal kong:8000 URL above - GoTrue signs
# tokens with its own public-facing API_EXTERNAL_URL as `iss`, and
# SUPABASE_JWT_ISSUER here must match that exactly or every request gets
# rejected. See backend/README.md's "Env" table.
SUPABASE_JWT_ISSUER=https://REPLACE_WITH_SUPABASE_DOMAIN/auth/v1
# Copy JWT_SECRET (not ANON_KEY/SERVICE_ROLE_KEY - those are JWTs signed
# WITH this secret, not the secret itself) from infra/supabase/.env.
SUPABASE_JWT_SECRET=REPLACE_WITH_SUPABASE_JWT_SECRET
# Optional - only needed once a module calls Supabase's admin API directly.
# Copy SERVICE_ROLE_KEY from infra/supabase/.env if so. Never expose it to a
# browser client.
SERVICE_ROLE_KEY=

############
# HTTP
############

# Do not change: infra/app/docker-compose.yml's healthcheck and
# infra/edge/Caddyfile's `reverse_proxy backend:3000` both hardcode 3000.
PORT=3000
# Comma-separated exact browser origins (no wildcards, no paths), HTTPS-only
# in production (enforced by backend/src/env.ts once NODE_ENV=production,
# which is baked into the image - see backend/Dockerfile). Typically just
# the webapp's public origin, matching infra/edge/.env's APP_DOMAIN.
CORS_ORIGINS=https://REPLACE_WITH_APP_DOMAIN
SHUTDOWN_GRACE_SECONDS=20

# Independent rate-limit budget for GET /api/admin/users, keyed by
# administrator id. See backend/README.md, "Admin API".
ADMIN_USERS_READ_RATE_LIMIT_MAX=120
ADMIN_USERS_READ_RATE_LIMIT_WINDOW_SECONDS=60

# The backend sits behind infra/edge's Caddy, which is a trusted reverse
# proxy - Caddy appends the real client IP as the last hop of
# X-Forwarded-For by default. Uncomment to have the backend read the real
# client IP from that header instead of the socket peer (Caddy's own
# address); leave unset (false) if nothing in this template yet reads
# client IP.
# TRUST_PROXY=true
# TRUSTED_PROXY_CLIENT_IP_HEADER=X-Forwarded-For
# TRUSTED_PROXY_CLIENT_IP_POSITION=last
