# Config for the backup stack (infra/backup/docker-compose.yml).
#
# Copy to .env and fill in real values - .env is gitignored (infra/**/.env
# in the root .gitignore) and never committed.

############
# S3-compatible storage
############

# Any S3-compatible provider works: AWS S3, Backblaze B2, Cloudflare R2,
# Hetzner Object Storage, MinIO, etc. Use a DEDICATED bucket for backups -
# see README.md "S3 bucket recommendations".
S3_ENDPOINT=https://s3.example.com
S3_BUCKET=REPLACE_WITH_BUCKET_NAME
# Path prefix inside the bucket. Change only if you run more than one
# vibestart instance into the same bucket.
S3_PATH=vibestart/postgres

AWS_ACCESS_KEY_ID=REPLACE_WITH_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_SECRET_KEY

############
# restic repository password
############

# Encrypts every snapshot. Generate with: openssl rand -base64 32
# LOSING THIS PASSWORD = LOSING ALL BACKUPS. There is no recovery. Store
# it somewhere durable and separate from this .env (password manager,
# secrets vault) before you rely on this system.
RESTIC_PASSWORD=REPLACE_WITH_GENERATED_SECRET

############
# Postgres connection
############

# Points at infra/supabase's `db` service over the shared `supabase`
# Docker network (see docker-compose.yml). PGPORT must match
# POSTGRES_PORT in infra/supabase/.env (default 54322) - Postgres listens
# on that port inside the container too, not 5432.
PGHOST=db
PGPORT=54322
PGUSER=postgres
PGDATABASE=postgres
# Copy the value of POSTGRES_PASSWORD from infra/supabase/.env by hand.
# Deliberately NOT auto-read from that file - this stack only knows about
# its own .env, so a stale copy here fails loudly (auth error) instead of
# silently backing up against the wrong password after a rotation.
PGPASSWORD=REPLACE_WITH_POSTGRES_PASSWORD_FROM_SUPABASE_ENV

# Hard per-invocation timeout (seconds) around every restic call. restic's
# own retry/backoff on backend errors has no built-in cap, so a bad
# credential or unreachable S3 endpoint would otherwise hang a run past
# its cron window and past the point where the failure heartbeat could
# ever fire - see README.md "Heartbeat".
RESTIC_TIMEOUT=1800

############
# Retention (restic forget --prune)
############

KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=6

# weekly = full `restic check` only on Sundays (default; check is a full
# data-integrity pass and can be slow/costly on egress for large repos).
# always = every run. never = disable (not recommended).
RESTIC_CHECK=weekly

############
# Schedule
############

# Standard 5-field cron expression, evaluated in TZ below. Default: 03:30
# daily - after typical low-traffic hours, before daily log rotation.
BACKUP_CRON=30 3 * * *
TZ=UTC

############
# Heartbeat (optional but recommended)
############

# Dead man's switch: a healthchecks.io-style push URL (also works with
# Uptime Kuma's push monitor type). backup.sh pings this URL on full
# success, and "$HEARTBEAT_URL/fail" on any failure - see README.md
# "Heartbeat setup". Leave empty to disable (a silent failure then looks
# like silence instead of an incident - not recommended for production).
HEARTBEAT_URL=
