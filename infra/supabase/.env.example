# Config for the self-hosted Supabase stack (infra/supabase/docker-compose.yml).
#
# Do NOT edit this file to hold real secrets. Run `bun run secrets:generate`
# from the repo root - it copies this file to `infra/supabase/.env`,
# filling every REPLACE_WITH_* placeholder with a freshly generated secret.
# `.env` is gitignored (see infra/**/.env in the root .gitignore) and is
# never committed.

############
# Postgres
############

# Host-published port AND the port Postgres listens on inside the container
# (supabase/postgres derives its own listen port from this same value).
# Bound to 127.0.0.1 only - never expose this publicly.
POSTGRES_PORT=54322
# do not change - init SQL scripts and JWT settings target the postgres database
POSTGRES_DB=postgres
POSTGRES_HOST=db
POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_SECRET

############
# JWT / API keys
############

# Signs and verifies every Supabase JWT (Auth, PostgREST, Realtime, Storage).
# 40+ random characters.
JWT_SECRET=REPLACE_WITH_GENERATED_SECRET
JWT_EXPIRY=3600

# HS256 JWTs signed with JWT_SECRET above: {"role":"anon"|"service_role","iss":"supabase"}.
# Safe to use client-side (anon) / server-side only (service_role, never expose it).
ANON_KEY=REPLACE_WITH_GENERATED_SECRET
SERVICE_ROLE_KEY=REPLACE_WITH_GENERATED_SECRET

############
# Studio dashboard access (Kong basic-auth)
############

DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=REPLACE_WITH_GENERATED_SECRET

############
# Service-specific encryption keys
############

# Realtime: encrypts Postgres change payloads. Must be exactly 16 characters.
REALTIME_DB_ENC_KEY=REPLACE_WITH_GENERATED_SECRET
# Realtime: session/cookie signing base. Must be at least 64 characters.
SECRET_KEY_BASE=REPLACE_WITH_GENERATED_SECRET
# Studio <-> postgres-meta: encrypts stored connection strings. 32+ characters.
PG_META_CRYPTO_KEY=REPLACE_WITH_GENERATED_SECRET

############
# URLs
############

KONG_HTTP_PORT=54321
SUPABASE_PUBLIC_URL=http://localhost:54321
API_EXTERNAL_URL=http://localhost:54321/auth/v1
SITE_URL=http://localhost:3000
ADDITIONAL_REDIRECT_URLS=

############
# Auth (GoTrue)
############

# PRODUCTION: before any public exposure, either
#   (a) set ENABLE_EMAIL_AUTOCONFIRM=false and fill in working SMTP_* below, or
#   (b) set DISABLE_SIGNUP=true.
# Autoconfirm with no SMTP means anyone can sign up with an unverified email
# and start using the app immediately. `bun run secrets:generate -- --prod`
# refuses to write .env if neither condition holds - see generate-secrets.ts.

DISABLE_SIGNUP=false

## Email auth
ENABLE_EMAIL_SIGNUP=true
# Local dev: auto-confirm so signup works without a working SMTP server.
# Production with real SMTP configured below: set this to false.
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_ANONYMOUS_USERS=false

## SMTP (disabled by default - GoTrue falls back to no email delivery)
SMTP_ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=

MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify

## Phone auth - disabled: no SMS provider configured.
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false

############
# PostgREST
############

PGRST_DB_SCHEMAS=public,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public

############
# Storage
############

STORAGE_FILE_SIZE_LIMIT=52428800

# file  = local dev default, writes into the storage-data Docker volume, no
#         S3 credentials required.
# s3    = production: set the GLOBAL_S3_*/AWS_*/REGION values below too.
STORAGE_BACKEND=file

# S3 bucket when STORAGE_BACKEND=s3, directory name when STORAGE_BACKEND=file.
GLOBAL_S3_BUCKET=stub
# Required when STORAGE_BACKEND=s3, e.g. https://s3.eu-central-1.amazonaws.com
# or an S3-compatible endpoint (R2, Backblaze B2, MinIO, ...).
GLOBAL_S3_ENDPOINT=
GLOBAL_S3_PROTOCOL=https
# Most S3-compatible providers (non-AWS) require path-style addressing.
GLOBAL_S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
REGION=stub

# Equivalent to project_ref; any stable identifier works for self-hosting.
STORAGE_TENANT_ID=stub

# Credentials for Storage's own S3-compatible protocol endpoint (lets S3
# clients talk directly to Storage). Independent of STORAGE_BACKEND above.
S3_PROTOCOL_ACCESS_KEY_ID=REPLACE_WITH_GENERATED_SECRET
S3_PROTOCOL_ACCESS_KEY_SECRET=REPLACE_WITH_GENERATED_SECRET

############
# imgproxy
############

IMGPROXY_AUTO_WEBP=true

############
# Studio
############

STUDIO_DEFAULT_ORGANIZATION=Default Organization
STUDIO_DEFAULT_PROJECT=Default Project
# Optional: enables the Studio AI assistant.
OPENAI_API_KEY=
