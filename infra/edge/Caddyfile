# Caddy edge-proxy for vibestart - production entrypoint of the VPS.
# Driven entirely by env vars ({$VAR}) from infra/edge/.env; see .env.example.
#
# Topology: this is the ONLY stack with ports published to the internet
# (80/443). Every other stack (infra/supabase, backend) stays bound to
# 127.0.0.1 or the internal `edge` Docker network and is reached here by
# Docker service name (kong, backend) - see infra/README.md for the diagram.
{
	email {$ACME_EMAIL}
}

# Security headers shared by every host. Studio (behind {$SUPABASE_DOMAIN})
# intentionally does NOT import this snippet - see that host block for why.
(security_headers) {
	header {
		# includeSubDomains omitted deliberately: it applies to every
		# subdomain of this host, including future ones that may not yet
		# serve HTTPS. Add it back only after confirming every subdomain
		# (present and planned) is HTTPS-only.
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

(compression) {
	encode zstd gzip
}

# JSON access logs to stdout (captured by `docker compose logs` / any log
# driver). Supabase REST/Storage/Realtime traffic carries `apikey` in the
# query string, and Storage presigned URLs carry `token`/signature params -
# both would otherwise land in plaintext logs. Redact the known-sensitive
# keys rather than dropping the whole query string, so non-sensitive query
# params (e.g. PostgREST filters) stay visible for debugging. Extend this
# list if a new query-carried secret shows up.
(access_log) {
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri query {
					delete apikey
					delete token
					delete token_hash
					delete access_token
					delete refresh_token
					delete code
					delete confirmation_url
					delete X-Amz-Signature
					delete X-Amz-Credential
					delete X-Amz-Security-Token
				}
				# Referer can carry the same sensitive query params (apikey,
				# token, etc.) via whatever page linked here - drop the
				# whole header rather than trying to redact its query string.
				request>headers>Referer delete
			}
		}
	}
}

# --- webapp: React CSR static build (T6) ---------------------------------
{$APP_DOMAIN} {
	import security_headers
	import compression
	import access_log

	# Bind-mounted read-only from ../../webapp/dist (see docker-compose.yml).
	root * /srv/webapp

	# `route` preserves this literal write order instead of Caddy's normal
	# automatic directive sorting, which always runs `header` before
	# `rewrite`/`file_server` regardless of where it's written in the
	# Caddyfile. That auto-sorting was the original bug here: a no-cache
	# header pinned to the literal path /index.html only ever matched a
	# direct request for that path, never a client route like /dashboard
	# that needs to be rewritten to it first.
	route {
		# (a) hashed, content-addressed filenames are safe to cache forever.
		@hashed path_regexp hashed \.[0-9a-f]{8,}\.(js|css|map|woff2?|svg|png|jpe?g|webp|ico)$
		header @hashed Cache-Control "public, max-age=31536000, immutable"

		# (b) a request that looks like a build asset (by extension) but
		# doesn't exist on disk is a real 404 - never an index.html
		# fallback. A missing asset from a broken deploy must fail loudly,
		# not silently serve the SPA shell with a 200.
		@missing_asset {
			path_regexp asset_ext \.(js|css|map|ico|png|svg|jpe?g|webp|woff2?)$
			not file
		}
		respond @missing_asset 404

		# (c) anything else that isn't a real file on disk is a client-side
		# route - rewrite to the SPA shell. `header` runs after this
		# rewrite (route order, not Caddy's auto-sort), so no-cache
		# correctly applies to every rewritten route, not just a literal
		# request to /index.html.
		@notStatic not file
		rewrite @notStatic /index.html
		header /index.html Cache-Control "no-cache"

		file_server
	}
}

# --- website: Astro static build (T7) -------------------------------------
{$SITE_DOMAIN} {
	import security_headers
	import compression
	import access_log

	# Bind-mounted read-only from ../../website/dist (see docker-compose.yml).
	root * /srv/website
	file_server
	handle_errors {
		rewrite * /404.html
		file_server
		# If 404.html doesn't exist (site not built yet, or Astro's default
		# 404 wasn't included), file_server 404s again here and Caddy falls
		# back to its built-in blank error response - no infinite loop.
	}
}

# --- backend: Bun+Hono API (T5) -------------------------------------------
{$API_DOMAIN} {
	import security_headers
	import compression
	import access_log

	# backend joins the `edge` network in T5; 502 until then is expected.
	reverse_proxy backend:3000
}

# --- Supabase: Kong gateway (APIs at /auth,/rest,/storage,/realtime + ----
# --- Studio dashboard at / with Kong-enforced basic-auth) -----------------
{$SUPABASE_DOMAIN} {
	import compression
	import access_log

	# No security_headers import here: X-Frame-Options DENY would break
	# Studio's SQL editor / table editor, which render some panels (e.g.
	# the AI assistant, embedded docs) in iframes. HSTS/nosniff/Referrer-
	# Policy are still applied explicitly below, and framing is restricted
	# to same-origin (SAMEORIGIN) rather than left fully open - only a
	# third-party site framing Studio for clickjacking is blocked.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Single upstream for everything: Kong routes /auth/v1, /rest/v1,
	# /storage/v1, /realtime/v1, and / (Studio, basic-auth enforced by
	# Kong's `dashboard` route) - never proxy the studio container directly.
	reverse_proxy kong:8000
}
