# Config for the Caddy edge-proxy stack (infra/edge/docker-compose.yml).
#
# LOCAL DEV: this stack is production-only. Local development runs vite
# (webapp) and astro (website) dev servers directly and talks to Supabase
# on http://localhost:54321 (infra/supabase/.env) - none of that goes
# through Caddy. Only set this up when deploying to a VPS.
#
# Copy to .env and fill in real values - .env is gitignored (infra/**/.env
# in the root .gitignore) and never committed.

# Contact address Let's Encrypt/ZeroSSL uses for expiry notices, required
# for ACME registration.
ACME_EMAIL=REPLACE_WITH_ACME_EMAIL

# One A/AAAA record per domain must point at this VPS before `docker
# compose up` - Caddy requests a cert for each host on first request and
# blocks that host until DNS resolves.
APP_DOMAIN=REPLACE_WITH_APP_DOMAIN
SITE_DOMAIN=REPLACE_WITH_SITE_DOMAIN
API_DOMAIN=REPLACE_WITH_API_DOMAIN
SUPABASE_DOMAIN=REPLACE_WITH_SUPABASE_DOMAIN
