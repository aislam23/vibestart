{
  "name": "vibestart",
  "private": true,
  "version": "0.0.0",
  "license": "Apache-2.0",
  "packageManager": "bun@1.3.14",
  "type": "module",
  "workspaces": [
    "packages/*",
    "backend"
  ],
  "overrides": {
    "@babel/core": "^7.29.7",
    "@hono/node-server": "^1.19.14",
    "esbuild": "^0.28.1",
    "hono": "^4.12.31",
    "js-yaml": "^4.3.0",
    "qs": "^6.15.3",
    "yaml": "^2.9.0"
  },
  "scripts": {
    "dev": "bun run --filter '*' --parallel dev",
    "build": "bun run --filter '*' --sequential build",
    "typecheck": "bun run --filter '*' --sequential typecheck",
    "test": "bun run test:contracts && bun run test:backend && bun run test:architecture && bun run architecture:check",
    "test:contracts": "bun run --cwd packages/contracts test",
    "dev:backend": "bun run --cwd backend dev",
    "build:backend": "bun run --cwd backend build",
    "typecheck:backend": "bun run --cwd backend typecheck",
    "test:backend": "bun run --cwd backend test",
    "test:backend:integration": "bun run --cwd backend test:integration",
    "smoke:backend:docker": "bun run --cwd backend smoke:docker",
    "test:architecture": "bun test scripts/architecture-check.test.mjs",
    "architecture:check": "bun run scripts/architecture-check.mjs",
    "secrets:generate": "bun infra/supabase/generate-secrets.ts"
  }
}
