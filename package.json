{
  "name": "vibestart",
  "private": true,
  "version": "0.0.0",
  "license": "Apache-2.0",
  "packageManager": "bun@1.3.14",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "@babel/core": "^7.29.7",
    "@hono/node-server": "^1.19.14",
    "esbuild": "^0.28.1",
    "hono": "^4.12.31",
    "js-yaml": "^4.3.0",
    "qs": "^6.15.3",
    "yaml": "^2.9.0"
  },
  "scripts": {
    "dev": "bun run --filter '*' --parallel dev",
    "build": "bun run --filter '*' --sequential build",
    "typecheck": "bun run --filter '*' --sequential typecheck",
    "test": "bun run test:contracts",
    "test:contracts": "bun run --cwd packages/contracts test"
  }
}
